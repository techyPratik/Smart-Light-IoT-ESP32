  // ===================================================
  // PIR WARMUP
  // ===================================================

  Serial.println(
    "PIR warming up..."
  );

  // -------------------------------------------------
  // OLED: PIR WARM-UP WAITING ANIMATION
  // Keeps the original 30-second warm-up time.
  // -------------------------------------------------

  if (oledOK)
  {
    unsigned long warmupStart = millis();
    int frame = 0;

    while (millis() - warmupStart < 30000UL)
    {
      display.clearDisplay();
      display.setTextColor(SSD1306_WHITE);
      display.setTextSize(1);

      display.setCursor(25, 5);
      display.println("SMART LIGHT");

      display.setCursor(27, 19);
      display.println("INITIALISING");

      display.setCursor(25, 33);
      display.println("PIR WARMING UP");

      // Spinner animation
      display.setCursor(57, 44);
      const char spinner[] = {'|', '/', '-', '\\'};
      display.print(spinner[frame % 4]);

      // 30-second progress bar
      display.drawRect(12, 54, 104, 8, SSD1306_WHITE);
      unsigned long elapsed = millis() - warmupStart;
      int progress = (int)((elapsed * 100UL) / 30000UL);
      if (progress > 100) progress = 100;
      display.fillRect(14, 56, (progress * 100) / 100, 4, SSD1306_WHITE);

      display.display();

      frame++;
      delay(250);
    }
  }
  else
  {
    // Keep the original PIR warm-up when OLED is unavailable.
    delay(30000);
  }

  Serial.println(
    "SYSTEM READY"
  );

  // -------------------------------------------------
  // OLED: SYSTEM READY
  // -------------------------------------------------

  if (oledOK)
  {
    display.clearDisplay();
    display.setTextColor(SSD1306_WHITE);
    display.setTextSize(1);

    display.setCursor(28, 10);
    display.println("SYSTEM READY");

    display.setCursor(25, 28);
    display.println("SMART LIGHT");

    display.setCursor(31, 45);
    display.println("IoT ONLINE");

    display.display();
    delay(1200);
  }
}


// =====================================================
// LOOP
// =====================================================

void loop()
{
  server.handleClient();


  int ldr =
    readLDR();


  updateLightState(ldr);


  // ===================================================
  // AUTO MODE
  // ===================================================

  if (autoMode)
  {

    // DAY

    if (!darkMode)
    {
      lightsOff();

      int pir = digitalRead(PIR_PIN);

      updateOLED(
        ldr,
        pir,
        0
      );

      delay(30);

      return;
    }


    // DARK

    int brightness =
      getBrightness(ldr);

    int pir =
      digitalRead(PIR_PIN);

    updateOLED(
      ldr,
      pir,
      brightness
    );


    // NEW PIR MOTION

    if (
      pir == HIGH &&
      previousPIR == LOW
    )
    {
      Serial.println(
        "PIR MOTION"
      );

      motionEffect(
        brightness
      );
    }


    previousPIR = pir;


    // NORMAL AMBIENT

    ambientLight(
      brightness
    );
  }


  // ===================================================
  // MANUAL RAINBOW
  // ===================================================

  else if (
    manualPower &&
    rainbowMode
  )
  {
    rainbowEffect();

    int pir = digitalRead(PIR_PIN);

    updateOLED(
      ldr,
      pir,
      manualBrightness
    );
  }


  // ===================================================
  // MANUAL SOLID
  // ===================================================

  else if (
    manualPower &&
    !rainbowMode
  )
  {
    int pir = digitalRead(PIR_PIN);

    updateOLED(
      ldr,
      pir,
      manualBrightness
    );

    // Already displayed by command.
    // Keep server responsive.

    delay(20);
  }


  delay(10);
}
