// =====================================================
// SETUP
// =====================================================

void setup()
{
  Serial.begin(115200);

  // ===================================================
  // OLED INITIALIZATION
  // ===================================================

  Wire.begin(OLED_SDA, OLED_SCL);

  if (display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR))
  {
    oledOK = true;

    // -------------------------------------------------
    // SCREEN 1: WELCOME ANIMATION
    // -------------------------------------------------

    display.setTextColor(SSD1306_WHITE);

    // Welcome title
    display.clearDisplay();
    display.setTextSize(2);
    display.setCursor(22, 5);
    display.println("WELCOME!");

    display.setTextSize(1);
    display.setCursor(31, 28);
    display.println("SMART LIGHT");

    // Smile appears
    display.drawCircle(64, 49, 12, SSD1306_WHITE);
    display.fillCircle(60, 46, 2, SSD1306_WHITE);
    display.fillCircle(68, 46, 2, SSD1306_WHITE);
    display.drawLine(59, 53, 61, 55, SSD1306_WHITE);
    display.drawLine(61, 55, 64, 56, SSD1306_WHITE);
    display.drawLine(64, 56, 67, 55, SSD1306_WHITE);
    display.drawLine(67, 55, 69, 53, SSD1306_WHITE);
    display.display();
    delay(2200);

    // -------------------------------------------------
    // SCREEN 2: INITIALISING + WAITING ANIMATION
    // -------------------------------------------------

    for (int frame = 0; frame < 8; frame++)
    {
      display.clearDisplay();
      display.setTextSize(1);

      display.setCursor(25, 5);
      display.println("SMART LIGHT");

      display.setCursor(27, 19);
      display.println("INITIALISING");

      display.setCursor(30, 33);
      display.print("PLEASE WAIT");

      // Animated dots
      display.setCursor(96, 33);
      for (int d = 0; d < (frame % 4); d++)
      {
        display.print(".");
      }

      // Animated progress bar
      display.drawRect(18, 48, 92, 9, SSD1306_WHITE);
      int progress = ((frame + 1) * 88) / 8;
      display.fillRect(20, 50, progress, 5, SSD1306_WHITE);

      display.setCursor(50, 59);
      display.print("LOADING");

      display.display();
      delay(250);
    }

    Serial.println("OLED READY");
  }
  else
  {
    oledOK = false;
    Serial.println("OLED NOT FOUND");
  }

  pinMode(PIR_PIN, INPUT);

  strip.begin();
  strip.clear();
  strip.show();

  manualColor =
    strip.Color(255, 150, 50);


  // ===================================================
  // WIFI ACCESS POINT
  // ===================================================

  WiFi.mode(WIFI_AP);

  WiFi.softAP(
    ssid,
    password
  );


  Serial.println();
  Serial.println("==============================");
  Serial.println(" SMART LIGHT");
  Serial.println("==============================");

  Serial.print("WiFi: ");
  Serial.println(ssid);

  Serial.print("IP: ");
  Serial.println(
    WiFi.softAPIP()
  );


  // ===================================================
  // HOME
  // ===================================================

  server.on(
    "/",
    HTTP_GET,
    []()
    {
      server.send(
        200,
        "text/html",
        webpage()
      );
    }
  );


  // ===================================================
  // STATUS
  // ===================================================

  server.on(
    "/status",
    HTTP_GET,
    []()
    {
      int ldr = readLDR();

      int pir =
        digitalRead(PIR_PIN);

      int brightness;


      if (autoMode)
      {
        brightness =
          darkMode
          ? getBrightness(ldr)
          : 0;
      }
      else
      {
        brightness =
          manualPower
          ? manualBrightness
          : 0;
      }


      String json = "{";


      json += "\"ldr\":";
      json += String(ldr);


      json += ",\"ambient\":\"";

      json +=
        darkMode
        ? "DARK"
        : "BRIGHT";

      json += "\"";


      json += ",\"pir\":\"";

      json +=
        pir
        ? "MOTION"
        : "NO MOTION";

      json += "\"";


      json += ",\"brightness\":";
      json += String(brightness);


      json += ",\"mode\":\"";

      json +=
        autoMode
        ? "AUTO"
        : "MANUAL";

      json += "\"";


      json += "}";


      server.send(
        200,
        "application/json",
        json
      );
    }
  );


  // ===================================================
  // AUTO
  // ===================================================

  server.on(
    "/auto",
    HTTP_GET,
    []()
    {
      autoMode = true;

      manualPower = false;

      rainbowMode = false;

      Serial.println("AUTO MODE");

      server.send(
        200,
        "text/plain",
        "AUTO"
      );
    }
  );


  // ===================================================
  // MANUAL
  // ===================================================

  server.on(
    "/manual",
    HTTP_GET,
    []()
    {
      autoMode = false;

      Serial.println("MANUAL MODE");

      server.send(
        200,
        "text/plain",
        "MANUAL"
      );
    }
  );


  // ===================================================
  // ON
  // ===================================================

  server.on(
    "/on",
    HTTP_GET,
    []()
    {
      autoMode = false;

      manualPower = true;

      rainbowMode = false;

      setAll(manualColor);

      Serial.println("MANUAL ON");

      server.send(
        200,
        "text/plain",
        "ON"
      );
    }
  );


  // ===================================================
  // OFF
  // ===================================================

  server.on(
    "/off",
    HTTP_GET,
    []()
