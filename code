// =====================================================
// HARDWARE
// =====================================================

#define LED_PIN 5
#define NUM_LEDS 60

#define LDR_PIN 34
#define PIR_PIN 27

// =====================================================
// OLED
// =====================================================

#define OLED_SDA 21
#define OLED_SCL 22
#define OLED_WIDTH 128
#define OLED_HEIGHT 64
#define OLED_ADDR 0x3C

Adafruit_SSD1306 display(
  OLED_WIDTH,
  OLED_HEIGHT,
  &Wire,
  -1
);

bool oledOK = false;

Adafruit_NeoPixel strip(
  NUM_LEDS,
  LED_PIN,
  NEO_GRB + NEO_KHZ800
);


// =====================================================
// WIFI
// =====================================================

const char* ssid = "YOUR_WIFI_NAME";
const char* password = "YOUR_WIFI_PASSWORD";

WebServer server(80);


// =====================================================
// LDR
// YOUR WORKING CALIBRATION
// =====================================================

#define DARK_THRESHOLD 1500
#define BRIGHT_THRESHOLD 2000

#define LDR_SAMPLES 10
#define LDR_CONFIRM_TIME 2000UL


// =====================================================
// SYSTEM
// =====================================================

bool darkMode = false;

bool autoMode = true;
bool manualPower = false;
bool rainbowMode = false;

bool previousPIR = LOW;

bool waitingDark = false;
bool waitingBright = false;

unsigned long ldrChangeStart = 0;


// =====================================================
// LED
// =====================================================

int manualBrightness = 70;

uint32_t manualColor;

uint16_t ambientHue = 0;
uint16_t rainbowHue = 0;

int motionColor = 0;


// =====================================================
// LDR READING
// =====================================================

int readLDR()
{
  long total = 0;

  for (int i = 0; i < LDR_SAMPLES; i++)
  {
    total += analogRead(LDR_PIN);
    delay(2);
  }

  return total / LDR_SAMPLES;
}


// =====================================================
// AUTOMATIC BRIGHTNESS
// =====================================================

int getBrightness(int ldr)
{
  int b = map(
    ldr,
    DARK_THRESHOLD,
    0,
    30,
    100
  );

  return constrain(b, 30, 100);
}


// =====================================================
// OLED DISPLAY
// =====================================================

void updateOLED(int ldr, int pir, int brightness)
{
  if (!oledOK)
    return;

  // Continuous OLED light animation
  static uint8_t lightFrame = 0;
  lightFrame++;

  bool lightIsOn =
    (autoMode && darkMode) ||
    (!autoMode && manualPower);

  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);

  // ---------------------------------------------------
  // SMART LIGHT TITLE
  // ---------------------------------------------------

  display.setTextSize(2);
  display.setCursor(0, 0);
  display.println("SMART");

  display.setCursor(0, 18);
  display.println("LIGHT");

  // ---------------------------------------------------
  // ANIMATED LIGHT ICON
  // A small glowing bulb with moving rays.
  // It runs continuously whenever the lights are ON.
  // ---------------------------------------------------

  if (lightIsOn)
  {
    int cx = 108;
    int cy = 18;

    // Bulb glow/pulse
    int pulse = (lightFrame % 16);
    if (pulse > 8)
      pulse = 16 - pulse;

    int radius = 7 + (pulse / 3);

    display.drawCircle(cx, cy, radius, SSD1306_WHITE);
    display.fillCircle(cx, cy, 3, SSD1306_WHITE);

    // Bulb base
    display.drawLine(cx - 4, cy + 8, cx + 4, cy + 8, SSD1306_WHITE);
    display.drawLine(cx - 3, cy + 10, cx + 3, cy + 10, SSD1306_WHITE);
    display.drawLine(cx - 2, cy + 12, cx + 2, cy + 12, SSD1306_WHITE);

    // Animated rays
    int ray = lightFrame % 4;

    if (ray == 0 || ray == 2)
    {
      display.drawLine(cx, cy - 13, cx, cy - 16, SSD1306_WHITE);
      display.drawLine(cx, cy + 15, cx, cy + 18, SSD1306_WHITE);
    }

    if (ray == 1 || ray == 3)
    {
      display.drawLine(cx - 13, cy, cx - 16, cy, SSD1306_WHITE);
      display.drawLine(cx + 13, cy, cx + 16, cy, SSD1306_WHITE);
    }

    // Corner rays always present for a nice glowing effect
    display.drawLine(cx - 10, cy - 10, cx - 13, cy - 13, SSD1306_WHITE);
    display.drawLine(cx + 10, cy - 10, cx + 13, cy - 13, SSD1306_WHITE);
    display.drawLine(cx - 10, cy + 10, cx - 13, cy + 13, SSD1306_WHITE);
    display.drawLine(cx + 10, cy + 10, cx + 13, cy + 13, SSD1306_WHITE);
  }
  else
  {
    // Small OFF indicator when the lights are off
    display.drawCircle(108, 18, 7, SSD1306_WHITE);
    display.drawLine(104, 14, 112, 22, SSD1306_WHITE);
    display.drawLine(112, 14, 104, 22, SSD1306_WHITE);
  }

  // ---------------------------------------------------
  // STATUS INFORMATION
  // ---------------------------------------------------

  display.setTextSize(1);

  display.setCursor(0, 38);
  display.print("AMBIENT : ");
  display.println(darkMode ? "DARK" : "BRIGHT");

  display.setCursor(0, 47);
  display.print("PIR     : ");
  display.println(pir == HIGH ? "MOTION" : "NO MOTION");

  display.setCursor(0, 56);
  display.print("MODE    : ");
  display.print(autoMode ? "AUTO" : "MANUAL");
  display.print("  ");
  display.print(brightness);
  display.print("%");

  display.display();
}


// =====================================================
// OFF
// =====================================================

void lightsOff()
{
  strip.clear();
  strip.show();
}


// =====================================================
// SOLID COLOUR
// =====================================================

void setAll(uint32_t color)
{
  strip.setBrightness(manualBrightness);

  for (int i = 0; i < NUM_LEDS; i++)
  {
    strip.setPixelColor(i, color);
  }

  strip.show();
}


// =====================================================
// AUTOMATIC AMBIENT LIGHT
// =====================================================

void ambientLight(int brightness)
{
  strip.setBrightness(brightness);

  for (int i = 0; i < NUM_LEDS; i++)
  {
    uint16_t hue =
      ambientHue +
      ((uint32_t)i * 65536UL / NUM_LEDS);

    strip.setPixelColor(
      i,
      strip.gamma32(
        strip.ColorHSV(hue)
      )
    );
  }

  strip.show();

  ambientHue += 2;
}


// =====================================================
// PIR EFFECT
// =====================================================

void motionEffect(int brightness)
{
  uint32_t color;

  switch (motionColor % 6)
  {
    case 0:
      color = strip.Color(255, 0, 0);
      break;

    case 1:
      color = strip.Color(255, 80, 0);
      break;

    case 2:
      color = strip.Color(255, 180, 0);
      break;

    case 3:
      color = strip.Color(0, 255, 80);
      break;

    case 4:
      color = strip.Color(0, 120, 255);
      break;

    default:
      color = strip.Color(180, 0, 255);
      break;
  }

  strip.setBrightness(brightness);

  for (int head = -5; head < NUM_LEDS + 5; head++)
  {
    for (int i = 0; i < NUM_LEDS; i++)
    {
      int d = abs(i - head);

      if (d == 0)
      {
        strip.setPixelColor(
          i,
          strip.Color(255, 255, 255)
        );
      }
      else if (d <= 2)
      {
        strip.setPixelColor(i, color);
      }
      else
      {
        strip.setPixelColor(
          i,
          strip.Color(
            ((uint8_t)(color >> 16)) / 5,
            ((uint8_t)(color >> 8)) / 5,
            ((uint8_t)color) / 5
          )
        );
      }
    }

    strip.show();
    delay(12);
  }

  motionColor++;
}


// =====================================================
// RAINBOW EFFECT
// =====================================================

void rainbowEffect()
{
  strip.setBrightness(manualBrightness);

  for (int i = 0; i < NUM_LEDS; i++)
  {
    uint16_t hue =
      rainbowHue +
      ((uint32_t)i * 65536UL / NUM_LEDS);

    strip.setPixelColor(
      i,
      strip.gamma32(
        strip.ColorHSV(hue)
      )
    );
  }

  strip.show();

  rainbowHue += 180;
}


// =====================================================
// FLOW EFFECT
// =====================================================

void flowEffect()
{
  uint32_t color =
    strip.Color(255, 80, 10);

  strip.setBrightness(manualBrightness);

  for (int head = -4; head < NUM_LEDS + 4; head++)
  {
    for (int i = 0; i < NUM_LEDS; i++)
    {
      int d = abs(i - head);

      if (d == 0)
      {
        strip.setPixelColor(
          i,
          strip.Color(255, 255, 255)
        );
      }
      else if (d <= 2)
      {
        strip.setPixelColor(i, color);
      }
      else
      {
        strip.setPixelColor(
          i,
          strip.Color(8, 3, 1)
        );
      }
    }

    strip.show();
    delay(10);

    // Keep web server alive
    server.handleClient();
  }
}


// =====================================================
// LDR HYSTERESIS
// =====================================================

void updateLightState(int ldr)
{
  // IMPORTANT:
  // LDR controls lighting only in AUTO mode.

  if (!autoMode)
  {
    return;
  }


  // ---------------- DARK ----------------

  if (ldr < DARK_THRESHOLD)
  {
    waitingBright = false;

    if (!darkMode)
    {
      if (!waitingDark)
      {
        waitingDark = true;
        ldrChangeStart = millis();
      }
      else if (
        millis() - ldrChangeStart >=
        LDR_CONFIRM_TIME
      )
      {
        darkMode = true;
        waitingDark = false;

        Serial.println("DARK CONFIRMED");
      }
    }

    return;
  }


  // ---------------- BRIGHT ----------------

  if (ldr > BRIGHT_THRESHOLD)
  {
    waitingDark = false;

    if (darkMode)
    {
      if (!waitingBright)
      {
        waitingBright = true;
        ldrChangeStart = millis();
      }
      else if (
        millis() - ldrChangeStart >=
        LDR_CONFIRM_TIME
      )
      {
        darkMode = false;
        waitingBright = false;

        lightsOff();

        Serial.println("BRIGHT CONFIRMED");
      }
    }

    return;
  }


  // ---------------- MIDDLE ----------------

  waitingDark = false;
  waitingBright = false;
}


